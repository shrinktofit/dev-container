{
  "extends": "@bsgames/workflow/tsconfig/lib",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "outDir": "lib",
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "customConditions": [
      "development"
    ],
    "types": [
      "electron-vite/node"
    ]
  },
  "include": [
    "scripts",
    "src"
  ]
}
